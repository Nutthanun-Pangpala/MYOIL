DATABASE_URL=postgres://myoil:myoil@localhost:5434/myoil
# any long random string — signs login cookies
SESSION_SECRET=change-me-to-a-long-random-string

# where invoice attachments / meter photos go later (stage 2). Not used in stage 1.
PHOTO_DIR=

# ── BookCare link (stage 2). Long random keys (≥ 32 bytes), set in .env and Vercel only — never in chat or commits ──
# BookCare calls MYOIL (API 1–6) with this key:
BOOKCARE_PUSH_KEY=
# MYOIL calls BookCare (API 7, project list) with this key, at this address:
BOOKCARE_API_URL=
BOOKCARE_PULL_KEY=
# Vercel Cron sends this to /api/cron/sync-projects (any random string ≥ 16 chars)
CRON_SECRET=
